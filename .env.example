DATABASE_URL=postgresql://user:password@host:5432/cop
COP_ADMIN_TOKEN=generate-a-long-random-token
PORT=3000
DATABASE_SSL=false

# Receptor SFTP usado pelos DVRs Intelbras.
SFTP_PORT=2222
SFTP_USERNAME=cop_ingest
COP_SFTP_PASSWORD=generate-a-strong-password-max-31
# Opcional: o COP usa automaticamente RAILWAY_TCP_PROXY_DOMAIN/PORT quando disponíveis.
SFTP_PUBLIC_HOST=
SFTP_PUBLIC_PORT=

COP_INGEST_ROOT=/data/sftp/incoming
COP_INGEST_POLL_MS=2500
COP_EVENT_GAP_SECONDS=35
COP_MAX_MEDIA_BYTES=12582912
